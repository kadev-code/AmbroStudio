{
  "name": "ambro-studio-app",
  "version": "0.6.2",
  "description": "Gestão local de produção, precificação e clientes da Ambro Personalizados.",
  "author": "Ambro Personalizados",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kadev-code/AmbroStudio.git"
  },
  "main": "desktop-dist/desktop/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host localhost --port 3000",
    "build": "tsc --noEmit && vite build",
    "desktop:compile": "tsc -p tsconfig.desktop.json",
    "desktop:dev": "pnpm desktop:compile && node scripts/desktop-dev.mjs",
    "desktop:dir": "pnpm build && pnpm desktop:compile && electron-builder --dir",
    "desktop:build": "pnpm build && pnpm desktop:compile && electron-builder --win nsis --publish never",
    "preview": "vite preview --host localhost --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "build": {
    "appId": "com.ambropersonalizados.studio",
    "productName": "Ambro Studio",
    "artifactName": "Ambro-Studio-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kadev-code",
        "repo": "AmbroStudio"
      }
    ],
    "files": [
      "dist/**/*",
      "desktop-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.0.13",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
