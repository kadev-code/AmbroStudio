{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "isolatedModules": false,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "desktop-dist",
    "rootDir": ".",
    "types": ["node", "electron"]
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.cts", "src/infrastructure/desktop/desktop-api.ts"]
}
